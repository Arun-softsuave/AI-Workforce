{
  "name": "ai-workforce-service",
  "version": "0.1.0",
  "private": true,
  "description": "AI Workforce local agent service (aiw-agentd), CLI and MCP server",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "aiw": "dist/cli/aiw.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=spec \"dist/test/*.test.js\" \"dist/test/situations/*.test.js\"",
    "start": "node dist/daemon/main.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^2.1.2",
    "mammoth": "^1.13.0",
    "unpdf": "^2.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
