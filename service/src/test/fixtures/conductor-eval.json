{
  "about": "Teams messages (real ones from the owner's chat, anonymised, plus SITUATIONS.md cases in the same style) with the situation they were sent in and the right action. `expect`: alternatives for the FIRST action ('tool[:action|mode|decision] [REF]'; a REF without @ also matches its repo parts). `all`: calls that must all appear. `noAction`: only reading or a reply – nothing may be started, changed or decided.",
  "scenario": "KAN-52 (two repos): PR #131 nue-backend (conflicts with dev), PR #90 nue-frontend. KAN-40 (two repos): PR #134 nue-backend, PR #95 nue-frontend. FIX-131@nue-backend paused. KAN-76 (L) and KAN-54 wait to start.",
  "cases": [
    { "id": "real-01", "text": "complete this ticket->KAN-52: [FR-019] Relevant questions only", "expect": ["start KAN-52", "status KAN-52"] },
    { "id": "real-02", "text": "/aiw resume kan-52@nue-backend", "expect": ["control:resume KAN-52@nue-backend"] },
    { "id": "real-03", "text": "what is the status of kan-52 whether the plan is ready?", "expect": ["status KAN-52"] },
    { "id": "real-04", "text": "plan for kan-52", "expect": ["start KAN-52", "status KAN-52"] },
    { "id": "real-05", "text": "resume", "expect": ["control:resume FIX-131@nue-backend", "control:resume"] },
    { "id": "real-06", "text": "Work this ticket kan-52", "expect": ["start KAN-52", "status KAN-52"] },
    { "id": "real-07", "text": "Okay based on the ticket and your idea start implementing this ticket correctly", "setup": { "approval": { "ref": "KAN-54", "action": "implement_plan" }, "focus": "KAN-54" }, "expect": ["decide:approve KAN-54", "decide:approve_with_change KAN-54"] },
    { "id": "real-08", "text": "/aiw resume kan-52", "expect": ["control:resume KAN-52"] },
    { "id": "real-09", "text": "What is the progress so far?", "setup": { "focus": "KAN-52" }, "expect": ["status KAN-52", "status"] },
    { "id": "real-10", "text": "resume it dont stop or pause for token limit", "setup": { "focus": "FIX-131@nue-backend" }, "expect": ["control:resume FIX-131@nue-backend", "set_directive", "prefs"], "all": ["control:resume FIX-131@nue-backend"] },
    { "id": "real-11", "text": "how many minutes it will take to plan for this ticket?", "setup": { "focus": "KAN-54" }, "noAction": true },
    { "id": "real-12", "text": "Work on kan-52 ticket", "expect": ["start KAN-52", "status KAN-52"] },
    { "id": "real-13", "text": "Question 1:\n\n1\n\nQuestion 2:\n\n3", "setup": { "question": { "ref": "KAN-54", "questions": [{ "question": "Show cancelled orders?", "options": ["Hide them", "Show them"] }, { "question": "Which currency?", "options": ["USD", "EUR", "The shop's currency"] }] }, "focus": "KAN-54" }, "expect": ["decide:answer KAN-54"] },
    { "id": "real-14", "text": "1.", "setup": { "approval": { "ref": "KAN-54", "action": "implement_plan" }, "focus": "KAN-54" }, "expect": ["decide:approve KAN-54"] },
    { "id": "real-15", "text": "Raise the pr and after all the tests ci/cd test passes notify me", "setup": { "approval": { "ref": "KAN-54", "action": "create_pr" }, "focus": "KAN-54" }, "expect": ["decide:approve KAN-54"] },
    { "id": "real-16", "text": "Give me the pdfs of this tickets", "setup": { "focus": "KAN-40" }, "expect": ["report KAN-40", "lookup KAN-40"] },
    { "id": "real-17", "text": "What are the tasks are in progress", "expect": ["status"] },
    { "id": "real-18", "text": "plan to do this ticket->KAN-40", "expect": ["start KAN-40", "status KAN-40"] },
    { "id": "real-19", "text": "okay continue planning kan-40 with the figma present", "expect": ["start KAN-40", "control:resume KAN-40", "status KAN-40"] },
    { "id": "real-20", "text": "Whether the planning is ready for this ticket -kan 40", "expect": ["status KAN-40"] },
    { "id": "real-21", "text": "1", "setup": { "approval": { "ref": "KAN-54", "action": "implement_plan" }, "focus": "KAN-54" }, "expect": ["decide:approve KAN-54"] },
    { "id": "real-22", "text": "Whether the implementation done for kan 40?", "expect": ["status KAN-40"] },
    { "id": "real-23", "text": "raise the pr", "setup": { "approval": { "ref": "KAN-54", "action": "create_pr" }, "focus": "KAN-54" }, "expect": ["decide:approve KAN-54"] },
    { "id": "real-24", "text": "1", "setup": { "question": { "ref": "KAN-54", "questions": [{ "question": "Show cancelled orders?", "options": ["Hide them", "Show them"] }] }, "focus": "KAN-54" }, "expect": ["decide:answer KAN-54"] },
    { "id": "real-25", "text": "CI test completed?", "setup": { "focus": "KAN-40" }, "expect": ["status KAN-40", "status"] },
    { "id": "real-26", "text": "both frontend ad backend PR for KAN-40 completed?", "expect": ["status KAN-40"] },
    { "id": "real-27", "text": "Is this for CI test failure?", "setup": { "focus": "FIX-131@nue-backend", "history": [["out", "🛑 FIX-131@nue-backend is stuck\nNo files were changed. Options: 1 retry · 2 take over · 3 cancel"]] }, "noAction": true },
    { "id": "real-28", "text": "yes", "setup": { "approval": { "ref": "KAN-54", "action": "create_pr" }, "focus": "KAN-54" }, "expect": ["decide:approve KAN-54"] },
    { "id": "recent-01", "text": "Check https://github.com/acme/backend/pull/134 https://github.com/acme/frontend/pull/95 and run the qa for this pr and add comments in issues if any", "expect": ["qa", "review"], "all": ["qa"] },
    { "id": "recent-02", "text": "Why it is failing check again and fix it", "setup": { "focus": "KAN-52@nue-backend", "history": [["out", "❌ CI failed on PR #131 (KAN-52@nue-backend): Lint & Format, Dependency Vulnerability Scan"]] }, "expect": ["fix_pr:ci KAN-52", "fix_pr:comments KAN-52"] },
    { "id": "recent-03", "text": "Hi", "noAction": true },
    { "id": "recent-04", "text": "it has conflicts recheck and resolve it properly", "setup": { "focus": "KAN-52@nue-backend", "history": [["out", "⚠️ PR #131 (KAN-52@nue-backend) conflicts with dev"]] }, "expect": ["fix_pr:rebase KAN-52", "fix_pr:comments KAN-52"] },
    { "id": "recent-05", "text": "\"resume FIX-131@nue-backend\"", "expect": ["control:resume FIX-131@nue-backend"] },
    { "id": "recent-06", "text": "resolve all the conflicts by yourself", "setup": { "focus": "KAN-52@nue-backend", "history": [["out", "⚠️ PR #131 (KAN-52@nue-backend) conflicts with dev\nA real conflict (2 files) – too big for me to resolve without your OK."]] }, "expect": ["fix_pr:rebase KAN-52"] },
    { "id": "recent-07", "text": "Is the conflicts resolved?", "setup": { "focus": "KAN-52@nue-backend" }, "expect": ["status KAN-52", "status"] },
    { "id": "sit-B7", "text": "do KAN-54 and KAN-76", "expect": ["start KAN-54", "start KAN-76", "start"], "all": ["start"] },
    { "id": "sit-J5", "text": "no, I meant KAN-76", "setup": { "focus": "KAN-54", "history": [["in", "start KAN-54"], ["out", "👍 On it – KAN-54: Export orders"]] }, "expect": ["control:undo", "start KAN-76", "control:cancel KAN-54"], "all": ["start KAN-76"] },
    { "id": "sit-J7", "text": "pause everything until Monday", "expect": ["control:pause"] },
    { "id": "sit-slots", "text": "use 4 slots", "expect": ["prefs"] },
    { "id": "sit-B20", "text": "only backend for KAN-76", "expect": ["set_directive KAN-76"] },
    { "id": "sit-H1", "text": "review PR 140", "expect": ["review"] },
    { "id": "sit-G2", "text": "fix the CI on PR 131", "expect": ["fix_pr:ci"] },
    { "id": "sit-J9", "text": "how much did KAN-52 cost?", "noAction": true },
    { "id": "sit-J8", "text": "why did you change the refund validator in KAN-40?", "expect": ["explain KAN-40", "lookup KAN-40", "status KAN-40"] },
    { "id": "sit-I3", "text": "stop, I'll do KAN-76 myself", "expect": ["control:takeover KAN-76", "control:cancel KAN-76"] },
    { "id": "sit-D4", "text": "yes but skip the email part", "setup": { "approval": { "ref": "KAN-54", "action": "implement_plan" }, "focus": "KAN-54" }, "expect": ["decide:approve_with_change KAN-54"] },
    { "id": "sit-C7", "text": "adapt KAN-52", "expect": ["adapt KAN-52"] },
    { "id": "sit-G11", "text": "resolve the comments on PR 90", "expect": ["fix_pr:comments"] },
    { "id": "sit-J1", "text": "how do refunds work in the backend?", "noAction": true },
    { "id": "sit-A9", "text": "Eric left the team", "expect": ["prefs"] }
  ]
}
